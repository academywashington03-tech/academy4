# Public (safe for browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only - NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Washington Academy <no-reply@your-domain.com>

# Optional
NEXT_PUBLIC_CONTACT_EMAIL=
# Set to 1 only after enabling Google sign-in in Supabase
NEXT_PUBLIC_GOOGLE_ENABLED=0

# Cloudflare Stream (video). Customer code looks like the part between "customer-" and ".cloudflarestream.com"
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# Paymob (Egypt) - use TEST keys until your merchant account is approved for live payments.
# Test keys and live keys must not be mixed (also the integration id).
PAYMOB_BASE_URL=https://accept.paymob.com

# Daily email backlog job (Vercel Cron sends this as a Bearer token). Generate a long random string.
CRON_SECRET=

# Content-Security-Policy: leave empty (report-only) until you have checked the browser console for violations, then set to 1 to enforce.
CSP_ENFORCE=

# ---- Used by scripts only (NEVER set these in Vercel) ----
# npm run test:sql  -> connection string of a SEPARATE TEST database (never production). Example shape: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# DATABASE_URL=
# npm run test:e2e  -> optional; base URL of a running instance and a test student account
# E2E_BASE_URL=
# E2E_STUDENT_EMAIL=
# E2E_STUDENT_PASSWORD=
